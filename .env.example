# Copy to .env (gitignored) and fill in. Never commit .env.
# Tableau UAT
TABLEAU_SERVER_URL=http://tableau-uat.example.com:8000/
TABLEAU_SITE_ID=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=

# Dev DWH (Windows authentication, no password)
CONN_DRIVER={ODBC Driver 17 for SQL Server}
CONN_SERVER=dev-dwh.example.com
CONN_DATABASE=YourDwhDatabase

# --- R1 settings (all optional, defaults shown) ---
# SCHEDULE_MODE=honour            # honour = send on the subscription's schedule days (D-036); ignore = old "every day when ready"
# SCHEDULE_CATCHUP_DAYS=3         # days after a due day on which it may still be sent
# MAPPING_MAX_AGE_H=26            # nothing is sent from a mapping older than this: schedule T2 more often than this
# EXPORT_PAUSE_SEC=20             # pause between two reports' exports (Tableau load)
# MAX_SENDS_PER_RUN=10            # reports claimed per 15-minute run
# MAX_CONCURRENT_REFRESHES=1      # t4: refresh jobs in flight at once
# REFRESH_STAGGER_SEC=60          # t4: seconds between job starts when more than one may run
# T2_PACE_SEC=0.5                 # t2: pause between workbooks
# T2_METADATA_PAGE=200            # t2: Metadata API page size
# T2_LOCK_RETRIES=10              # t2: tries (30 s apart) when the PAT lock is busy
# PAT_BUSY_ALERT_AFTER=4          # alert after this many PAT-busy skips in a row
# TAKEOVER_GONE_CLOSE_DAYS=7      # close an open takeover row whose subscription is gone this long
# TABLEAU_AUTOMATION_DISABLED=1   # KILL SWITCH (or create the file out/KILL)
# TABLEAU_IMPERSONATOR_NAME=      # optional (D-063): shared admin account used only to export per-user-filter reports as the subscriber
# TABLEAU_IMPERSONATOR_PASSWORD=
# RENDER_AS_SUBSCRIBER=1           # 1 = export every report as its subscriber (needs the two lines above); 0 or unset = as the service account
# ALERT_TO=you@example.com
# SEND_ALLOWED_RECIPIENTS=...     # must include ALERT_TO when sending for real

# --- Mail (D-042, D-043) ---------------------------------------------------------------------------------------
# MAIL_TRANSPORT=local            # local = test sink, nobody is told anything; smtp (alias ses) = REAL mail from every script
# SMTP_PROVIDER=gmail             # ses | gmail | generic (inferred from SMTP_HOST if unset); decides which replies may free a slot
# SMTP_HOST=smtp.gmail.com        # SES: email-smtp.ap-northeast-1.amazonaws.com
# SMTP_PORT=587                   # STARTTLS
# SMTP_USER=                      # Gmail: the address. (SES_SMTP_USER is still accepted)
# SMTP_PASSWORD=                  # Gmail: a Google app password. (SES_SMTP_PASSWORD is still accepted). Never commit or print it.
# SEND_FROM=                      # Gmail rewrites From to SMTP_USER unless it is a verified alias: use the same address for testing
# ADDR_HASH_SALT=                 # any random text: salts the short recipient hash in the logs
# T4_MAX_LOCK_MIN=10              # t4 holds the shared Tableau login at most this long per run
# TABLEAU_BUSY_CHECK=1             # t4/t6 wait while Tableau has someone else's Pending/InProgress jobs (D-057); 0 = off (tests only)
# TABLEAU_BUSY_STALE_HOURS=6       # Pending jobs older than this are ignored (stale leftovers), with a warning
# TABLEAU_HTTP_TIMEOUT_S=1500      # seconds to wait for one Tableau request (exports); default 25 min
# EVENTLOG_DISABLED=1             # do not write the Windows Event Log (source TableauAutomation)
# KILL_FILE=                      # path of the kill-switch file (default out/KILL)

# --- Environment guards and addresses (no defaults: unset = the guard refuses / the address is empty) ---
# Dev DWH guard: t2 and t4 only run when CONN_SERVER / CONN_DATABASE equal these (case-insensitive)
DEV_DWH_SERVER=dev-dwh.example.com
DEV_DWH_DATABASE=YourDwhDatabase
# SEND_ALLOW_ALL_UAT only takes effect when the host of TABLEAU_SERVER_URL equals this exactly
UAT_TABLEAU_HOST=tableau-uat.example.com
# Default alert recipient when ALERT_TO is unset, and the display From address when SEND_FROM is unset
OWNER_EMAIL=you@example.com
DEFAULT_SENDER_EMAIL=tableau-reports@example.com
